# ==============================================================================
# ORVEXA CRM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Optional - enables AI Co-Pilot assistant features in CRM.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional - canonical domain or deployment URL (e.g., https://my-orvexa-crm.vercel.app)
APP_URL="https://your-domain.vercel.app"

# ==============================================================================
# OPTIONAL: SUPABASE AUTH & POSTGRESQL INTEGRATION
# ==============================================================================
# If connecting ORVEXA CRM to an external Supabase instance for Auth and Database:
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="your-anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
